# Optional launch integrations
# Add these in Netlify Site configuration > Environment variables.

# Google Analytics Measurement ID, for example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# Google Search Console HTML tag verification content value.
# If Google gives: <meta name="google-site-verification" content="abc123" />
# use only: abc123
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
